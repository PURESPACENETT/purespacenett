# Local development variables
# Copy this file to .env and fill in values for your environment.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_TRACKING_ID=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# B2B CRM bridge (server-only)
FUNNEL_B2B_WEBHOOK_URL=
FUNNEL_B2B_WEBHOOK_SECRET=

# Standard quote CRM bridge (server-only)
FUNNEL_QUOTE_WEBHOOK_URL=
FUNNEL_QUOTE_WEBHOOK_SECRET=

# Clay prospect enrichment (server-only)
CLAY_API_KEY=

# OpenAI (server-only, required for CRM AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Google Ads conversion tracking (client-side, requires consent)
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Google Search Console (server-only, OAuth refresh token required)
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# Scheduled jobs (server-only)
CRON_SECRET=
CRON_SECRET_PREVIOUS=
PROSPECTION_CRON_SECRET=
AUTOMATION_CRON_SECRET=

# Database migrations (server-only)
DATABASE_URL=
SUPABASE_DB_URL=

# Transactional email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
